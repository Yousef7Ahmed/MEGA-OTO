# --- Server ---
PORT=3000

# --- OTO ---
# Get this from app.tryoto.com -> Settings -> Developers -> API integrations -> connect (per store).
# IMPORTANT: regenerate a fresh one and never commit this file with a real value.
OTO_REFRESH_TOKEN=REPLACE_ME
OTO_BASE_URL=https://api.tryoto.com/rest/v2

# Secret used to sign/verify OTO's outbound webhook payloads (orderStatus / shipmentError).
# You choose this value yourself when you register the webhook (see scripts/registerOtoWebhook.js).
OTO_WEBHOOK_SECRET=choose-a-long-random-string

# Public URL where THIS server is reachable from the internet, so OTO can call it back.
# While developing locally, use a tunnel (e.g. ngrok) and put its https URL here.
PUBLIC_BASE_URL=https://your-public-url.example.com

# --- Mega Ai ---
# Optional: if Mega Ai's outbound webhook supports a shared secret / signature, put it here.
# We don't know the exact mechanism yet - fill in once confirmed.
MEGA_WEBHOOK_SHARED_SECRET=

# UNCONFIRMED API - get this from the store owner (should look like mgt_...).
# This is what we're testing with scripts/testMegaApi.js. If it doesn't work,
# it means megaa-tons-external-api-docs.md was not accurate.
MEGA_API_KEY=
MEGA_BASE_URL=https://megaa-tons.net/api/external

# --- Mrsool ---
# Not confirmed yet. Fill in once we have real Mrsool API docs + credentials.
MRSOOL_API_KEY=
MRSOOL_BASE_URL=

# --- Dynamic shipping rates ---
# City OTO should quote pickup from (your warehouse/store city).
SHIPPING_ORIGIN_CITY=Riyadh
# Any long random string. Set here AND pass the same value when running
# scripts/registerShippingProvider.js, so Mega Ai sends it back to us and
# we can verify the callback really came from Mega Ai.
SHIPPING_CALLBACK_SECRET=choose-another-long-random-string
